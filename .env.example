# Адрес сайта после публикации (без слэша в конце). Нужен для canonical, sitemap и превью ссылок.
NEXT_PUBLIC_SITE_URL=https://oner-mektebi.kz

# Supabase — необязательно. Без этих двух переменных сайт работает на контенте из src/content,
# а /admin показывает инструкцию по подключению.
# Settings → API в панели Supabase: Project URL и публичный ключ (anon / publishable).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Демо-материалы с пометкой «Үлгі / Образец», чтобы посмотреть галерею, плееры и афиши.
# На рабочем сайте должно быть false.
NEXT_PUBLIC_DEMO_CONTENT=false
